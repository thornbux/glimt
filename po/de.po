msgstr "Konnte die Sammlung nicht umbenennen: {e}"

#: src/viewer/view.rs
msgid "Could not open {name}:\n{e}"
msgstr "Konnte {name} nicht öffnen:\n{e}"

#: src/images/save.rs
msgid "only JPEG, PNG and WebP can store the rotation"
msgstr "nur JPEG, PNG und WebP können die Drehung speichern"

#: src/images/save.rs
msgid "animated images are not turned"
msgstr "animierte Bilder werden nicht gedreht"

#: src/images/save.rs
msgid "animated images are not saved as a copy"
msgstr "animierte Bilder werden nicht als Kopie gespeichert"

#: src/images/save.rs
msgid "the part is outside the image"
msgstr "der Ausschnitt liegt außerhalb des Bildes"

#: src/images/save.rs
