#!/usr/bin/env python3
"""A Glimt plugin: a short description of each image, made by a vision model running on this
computer (Ollama), written as the image's comment and as its IPTC alt text in its XMP sidecar
(<image>.xmp): Glimt shows both, a screen reader reads the alt text first, and exif: searches
find the comment.

Safety, as "Scripts and AI" on https://glimt.pario.no/scripts-and-ai/ says:
- Only a model on this computer is asked: the images never leave it. GLIMT_AI_URL must be a
  loopback address (127.0.0.1, ::1 or localhost).
- The files come as arguments, never through a shell.
- What the model answers is only ever text in the comment: never run, never a file name. It is
  cut to one paragraph and stripped of control characters, as a picture can carry words meant
  to steer the model ("ignore the above and ...").
- A comment or alt text that is there already is kept: nothing the user wrote is replaced.
- exiftool writes the sidecar, so the text is escaped as XML needs.

Needs: python3, exiftool, and Ollama with a vision model (ollama pull llava).
Settings: GLIMT_AI_MODEL (default llava), GLIMT_AI_URL (default http://127.0.0.1:11434).
"""

import base64
import ipaddress
import json
import os
import stat
import subprocess
import tempfile
import sys
import urllib.parse
import urllib.request

MODEL = os.environ.get("GLIMT_AI_MODEL", "llava")
URL = os.environ.get("GLIMT_AI_URL", "http://127.0.0.1:11434")
PROMPT = (
    "Describe this photo in one or two plain sentences for someone who cannot see it: "
    "what is in it, where, and the light. Describe only what is visible."
)
MAX_BYTES = 40 << 20  # a larger file is left out: the model gets a whole copy of it
MAX_TEXT = 500
# A sidecar that has no XMP yet starts as this empty packet, which exiftool can write into.
EMPTY_XMP = b'<x:xmpmeta xmlns:x="adobe:ns:meta/"></x:xmpmeta>\n'


def local(url):
    """True if `url` is on this computer."""
    host = urllib.parse.urlsplit(url).hostname or ""
    if host == "localhost":
        return True
    try:
        return ipaddress.ip_address(host).is_loopback
    except ValueError:
        return False


def describe(path):
    """The model's description of the image at `path`, as one clean paragraph."""
    with open(path, "rb") as f:
        image = base64.b64encode(f.read()).decode()
    body = json.dumps({"model": MODEL, "prompt": PROMPT, "images": [image], "stream": False})
    request = urllib.request.Request(
        URL.rstrip("/") + "/api/generate",
        data=body.encode(),
        headers={"Content-Type": "application/json"},
    )
    with urllib.request.urlopen(request, timeout=300) as answer:
        text = json.load(answer).get("response", "")
    # One paragraph of printable text: no control characters, no line breaks.
    text = " ".join("".join(c if c.isprintable() else " " for c in text).split())
    return text[:MAX_TEXT]


# Where the description goes: the comment Glimt shows, and IPTC's alt text, which screen
# readers and web pages read.
FIELDS = ["XMP-dc:Description", "XMP-iptcCore:AltTextAccessibility"]


def read_sidecar(sidecar):
    """Reads the sidecar. Returns b"" when there is none. Raises OSError when it is a link or
    not a file.

    A sidecar that is a link is not the image's own: a downloaded folder could point it at any
    file of the user's, which would then be read and written. The file is opened without
    following a link and read from what was opened, so a link put there after a check is never
    followed. Glimt leaves such a sidecar alone too.
    """
    try:
        fd = os.open(sidecar, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except FileNotFoundError:
        return b""
    with os.fdopen(fd, "rb") as f:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            raise OSError("not a file")
        return f.read(MAX_BYTES)


def exiftool(args, given):
    """Runs exiftool on the XMP `given` on its standard input ("-"). Returns what it printed."""
    out = subprocess.run(["exiftool", *args, "-"], input=given, capture_output=True)
    if out.returncode != 0:
        raise OSError(out.stderr.decode(errors="replace").strip())
    return out.stdout


def seed(path):
    """The XMP a new sidecar starts with: the image's own. Glimt reads the keywords and the
    comment from the sidecar once it has a description, so the image's own must be in it, and a
    description the image has already is then kept. An image without XMP starts empty."""
    out = subprocess.run(["exiftool", "-xmp", "-b", path], capture_output=True)
    return out.stdout or EMPTY_XMP


def empty_fields(xmp):
    """The fields of FIELDS the XMP has no text in."""
    return [f for f in FIELDS if not exiftool(["-s3", f"-{f}"], xmp).strip()]


class Changed(Exception):
    """The sidecar changed between reading it and replacing it."""


def replace(sidecar, data, read):
    """Writes `data` as the sidecar, whole or not at all. The new file is made under a name of
    its own and renamed over the sidecar, which replaces a link put there rather than follow it.
    Raises Changed, and writes nothing, when the sidecar no longer holds `read`, what `data` was
    made from: Glimt wrote it meanwhile, and replacing it would lose that.

    shortcut: a write in the moment between the last read and the rename is still lost, as the
    plugin cannot take the lock Glimt's own sidecar writes take; a plugin API that writes
    through Glimt would close it."""
    fd, temp = tempfile.mkstemp(dir=os.path.dirname(sidecar), prefix=".glimt-describe-")
    # mkstemp makes the file readable by its owner only; a sidecar gets the usual permissions.
    umask = os.umask(0)
    os.umask(umask)
    try:
        os.fchmod(fd, 0o666 & ~umask)
        with os.fdopen(fd, "wb") as f:
            f.write(data)
        if read_sidecar(sidecar) != read:
            raise Changed()
        os.replace(temp, sidecar)
    except (OSError, Changed):
        os.unlink(temp)
        raise


def main(paths):
    if not local(URL):
        sys.exit(f"glimt-describe: {URL} is not on this computer; images are only sent to a local model")
    failed = 0
    for path in paths:
        path = os.path.abspath(path)
        if not os.path.isfile(path) or os.path.getsize(path) > MAX_BYTES:
            print(f"{path}: not a file, or larger than {MAX_BYTES >> 20} MB: left out", file=sys.stderr)
            continue
        sidecar = path + ".xmp"
        try:
            xmp = read_sidecar(sidecar) or seed(path)
            fields = empty_fields(xmp)
        except OSError as e:
            print(f"{sidecar}: {e.strerror or e}: left alone", file=sys.stderr)
            continue
        if not fields:
            print(f"{path}: has a comment and an alt text already: kept", file=sys.stderr)
            continue
        try:
            text = describe(path)
        except OSError as e:
            failed += 1
            print(f"{path}: the model did not answer: {e}", file=sys.stderr)
            continue
        if not text:
            continue
        # The sidecar is read again, as Glimt may have written it while the model was thinking.
        # Only that fresh copy is changed, so a keyword or stars added meanwhile are kept.
        # One argument each, so exiftool reads the text as no option. It writes the changed XMP
        # to its standard output ("-o -"), and the sidecar is replaced with that.
        # When Glimt writes the sidecar while it is being changed here, the change is made again
        # from what Glimt wrote; a few tries, as each takes only as long as two exiftool runs.
        for _ in range(5):
            try:
                read = read_sidecar(sidecar)
                xmp = read or seed(path)
                fields = empty_fields(xmp)
                if fields:
                    args = ["-q", *[f"-{f}={text}" for f in fields], "-o", "-"]
                    replace(sidecar, exiftool(args, xmp), read)
                break
            except Changed:
                continue
            except OSError as e:
                failed += 1
                print(f"{path}: {e}", file=sys.stderr)
                break
        else:
            failed += 1
            print(f"{path}: the sidecar kept changing: left alone", file=sys.stderr)
    sys.exit(1 if failed else 0)


if __name__ == "__main__":
    main(sys.argv[1:])
