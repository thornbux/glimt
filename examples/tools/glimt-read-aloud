#!/usr/bin/env python3
"""A Glimt tool: reads the selected images aloud, one after the other, without a screen
reader: the IPTC alt text from each image's XMP sidecar (<image>.xmp), or else its comment, or
else its file name. Run it from Edit → Tools.

Speaks through speech-dispatcher (spd-say), which GNOME and KDE have; reads the sidecar with
exiftool. Nothing leaves the computer.

Needs: spd-say (speech-dispatcher) and exiftool. GLIMT_SPEAK_LANGUAGE sets the language (en, nb …).
"""

import os
import stat
import subprocess
import sys

FIELDS = ["XMP-iptcCore:AltTextAccessibility", "XMP-dc:Description"]
MAX_SIDECAR = 4 << 20


def sidecar_bytes(sidecar):
    """Reads the sidecar. Returns b"" when there is none, or when it is a link or not a file.

    A sidecar that is a link is not the image's own: a downloaded folder could point it at any
    file of the user's, which would then be read aloud. The file is opened without following a
    link and read from what was opened, so a link put there after a check is never followed.
    Glimt does not read such a sidecar either.
    """
    try:
        fd = os.open(sidecar, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError:
        return b""
    with os.fdopen(fd, "rb") as f:
        return f.read(MAX_SIDECAR) if stat.S_ISREG(os.fstat(fd).st_mode) else b""


def text_of(path):
    """What to say for the image at `path`."""
    xmp = sidecar_bytes(path + ".xmp")
    # exiftool reads the sidecar from its standard input ("-"), never by its name.
    for source, given in ([("-", xmp)] if xmp else []) + [(path, None)]:
        for field in FIELDS:
            out = subprocess.run(["exiftool", "-s3", f"-{field}", source], input=given, capture_output=True)
            text = " ".join(out.stdout.decode(errors="replace").split())
            if text:
                return text
    return os.path.basename(path)


def main(paths):
    language = os.environ.get("GLIMT_SPEAK_LANGUAGE")
    for path in paths:
        # -w waits until it is said, so the next comes after; the text is one argument of its own.
        command = ["spd-say", "-w"] + (["-l", language] if language else []) + ["--", text_of(os.path.abspath(path))]
        if subprocess.run(command).returncode != 0:
            sys.exit("spd-say (speech-dispatcher) could not speak")


if __name__ == "__main__":
    main(sys.argv[1:])
