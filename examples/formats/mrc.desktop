[Glimt Decoder]
Name=Cryo-EM (MRC)
Comment=MRC files from cryo-electron microscopy and tomography: a micrograph, or the middle section of a map
# map is EMDB's ending for maps, and also that of other programs' text files (source maps), which
# this then fails on: remove it if such files are where your pictures are.
Extensions=mrc;mrcs;map;rec;st;ali
Exec=glimt-mrc %f
