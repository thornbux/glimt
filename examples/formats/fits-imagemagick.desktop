[Glimt Decoder]
Name=FITS (ImageMagick)
Comment=FITS through ImageMagick, for a computer without astropy: fits.desktop comes first by name, and takes these when both are there
Extensions=fits;fit;fts
# %f[0]: the first plane of a cube. -auto-level stretches the values from the lowest to the
# highest, as the data is seldom 0-255.
# The format is named before the path ("fits:"): without it ImageMagick goes by what the bytes
# say, and a file from the internet named .fits could reach Ghostscript or another coder.
Exec=convert fits:%f[0] -auto-level -depth 8 ppm:-
